<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>ufb-agent</string>
    <key>CFBundleIdentifier</key>
    <string>dev.ufb.agent</string>
    <key>CFBundleName</key>
    <string>ufb-agent</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.1.2</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- LSUIElement = YES → no Dock icon, no menu bar. Daemon-style.
         Icon is set anyway so Activity Monitor / `lsappinfo` show it
         consistently with UFB.app + UFBTray.app. -->
    <key>LSUIElement</key>
    <true/>
    <key>CFBundleIconFile</key>
    <string>UFB</string>
    <key>NSHumanReadableCopyright</key>
    <string>UFB Mount Agent. GPL-3.0-or-later.</string>
</dict>
</plist>
