<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime parity with UFB.app. The agent dlopens the
         system NFS / SMB stack (mount_smbfs, mount_nfs) via shell
         commands; bundled dylibs ship for vendored sync deps. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- IPC socket listener + outbound network for SMB / NFS / mesh. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- Same app group: agent's IPC socket lives at
         ~/Library/Group Containers/<group>/a.sock (kept short for
         macOS sun_path ≤ 104 limit). -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>5Z4S9VHV56.group.com.unionfiles.ufb</string>
    </array>

    <!-- See note in app/UFB.entitlements: keychain-access-groups
         is restricted on macOS Developer-ID-with-hardened-runtime
         without a provisioning profile. Until we wire one in, the
         agent reads via service-name only and accepts the per-app
         ACL prompt UX. -->
</dict>
</plist>
